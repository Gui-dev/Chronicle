{
  "name": "chronicle",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @chronicle/db generate",
    "db:migrate": "pnpm --filter @chronicle/db migrate",
    "db:studio": "pnpm --filter @chronicle/db studio",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "concurrently": "^9.0.0",
    "lefthook": "^1.10.0",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "lefthook"]
  }
}
